# Public values are embedded in the APK. Never put API keys or session secrets here.
EXPO_PUBLIC_API_URL=https://steam-achievements-viewer.onrender.com/api

# Build-time app identity. Keep the callback scheme fixed unless the backend is updated too.
APP_NAME=Steam Achievements
ANDROID_PACKAGE=com.steamachievements.viewer
IOS_BUNDLE_IDENTIFIER=com.steamachievements.viewer
APP_VERSION=1.0.0
ANDROID_VERSION_CODE=1

# Optional LAN testing; leave false for builds using the hosted HTTPS backend.
ALLOW_LOCAL_HTTP=false
